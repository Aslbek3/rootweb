# ============================================================
# Claude Code Web — sozlamalar
# ============================================================
# Bitta kod ikki xil o'rnatmada ishlaydi (`server/config.js`ga qarang).
# Farq faqat shu fayldagi qiymatlarda.

# --- Instansiya turi ---
#   root     — to'liq VPS boshqaruvi (rootweb). Favqulodda amallar yoqilgan,
#              standart ruxsat rejimi "avto".
#   sandbox  — kod yozish muhiti (claudeuz). Alohida tizim foydalanuvchisi,
#              ACL bilan o'z papkasiga qamalgan, standart rejim "manual",
#              favqulodda amallar o'chirilgan.
INSTANCE_MODE=root

# --- Kirish ---
# Telefon/brauzerdan kirishda so'raladigan parol. ALBATTA o'zgartiring.
# Vergul bilan bir nechta parol berish mumkin.
APP_PASSWORD=change-me

# Cookie imzolash kaliti. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bo'sh qoldirilsa har restartda sessiyalar bekor bo'ladi.
SESSION_SECRET=

# --- Tarmoq ---
PORT=3210
# nginx orqasida: 127.0.0.1 (tashqaridan portga to'g'ridan-to'g'ri kirish yo'q)
HOST=127.0.0.1
# nginx/HTTPS orqasida 1 qiling — cookie'ga Secure qo'yiladi va haqiqiy IP
# aniqlanadi (login cheklovi uchun muhim).
TRUST_PROXY=1

# Ilova ochiladigan manzil. WebSocket Origin tekshiruvi shunga tayanadi
# (CSWSH himoyasi). Bo'sh qoldirilsa so'rovning Host sarlavhasi ishlatiladi.
PUBLIC_ORIGIN=https://example.duckdns.org

# --- Claude ---
# Claude qaysi papkada ishlaydi. Bu papka MAVJUD bo'lishi shart — aks holda
# server "native binary failed to launch" degan chalg'ituvchi xato beradi.
PROJECT_DIR=./workspace

# Autentifikatsiya: yo terminalda `claude auth login`, yo API kalit:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Resurs cheklovi (docs/resurs-cheklovi.md) ---
# Har bir ochiq sessiya alohida `claude` subprocess (~300-400 MB).
# Bu cheklovlar OOM killer tasodifiy botni o'ldirmasligi uchun.
MAX_SESSIONS=3
SESSION_IDLE_MINUTES=45

# --- Ixtiyoriy funksiyalar ---
# Ichki veb-ilovaga proksi (sandbox'da `savdo-hisob`). 0 = o'chirilgan.
PROXY_PORT=0
PROXY_PREFIX=/savdo

# --- Login cheklovi (server/auth.js) ---
# ⚠️ fail2ban bilan BOG'LIQ: chegaraga yetganda 401 emas, 429 qaytariladi,
# shunda parolni adashib teruvchi foydalanuvchi IP-ban bo'lmaydi.
# Bu qiymat o'zgarsa jail.local dagi maxretry ham qayta ko'rilishi shart.
LOGIN_MAX_FAILED=4
LOGIN_WINDOW_MS=900000

# Sessiya cookie muddati (millisekund). Standart: 24 soat.
SESSION_MAX_AGE_MS=86400000
